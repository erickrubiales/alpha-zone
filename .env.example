# Configuração do projeto Firebase do Alpha Zone.
# Copie para .env e preencha com os valores do console (Configurações do projeto →
# Seus apps → Configuração do SDK). Estes valores NÃO são segredos: identificam o
# projeto; quem protege os dados são as regras do Firestore.
#
# ATENÇÃO: projeto PRÓPRIO, isolado do app da loja Alvos NG. Reaproveitar o projeto
# da loja misturaria as bases de usuários e tornaria impossível separar a assinatura.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth client id da WEB (Firebase → Authentication → Google → ID do cliente da Web).
# NÃO é o client id do Android nem o do iOS — trocar produz DEVELOPER_ERROR.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
